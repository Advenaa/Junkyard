name: Clanker Verify

on:
  workflow_dispatch:
  schedule:
    - cron: "17 * * * *"
  workflow_run:
    workflows: ["CI"]
    types:
      - completed

concurrency:
  group: clanker-verify
  cancel-in-progress: false

permissions:
  actions: read
  contents: read
  issues: write

jobs:
  verify:
    if: |
      github.event_name != 'workflow_run' ||
      (github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.head_branch == 'main')
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4
        with:
          ref: main

      - uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Run autonomous smoke verify
        env:
          GH_TOKEN: ${{ github.token }}
          GITHUB_TOKEN: ${{ github.token }}
          GITHUB_REPOSITORY: ${{ github.repository }}
          PUBLIC_URL: ${{ vars.PUBLIC_URL }}
          CLANKER_VERIFY_BASE_URL: ${{ vars.CLANKER_VERIFY_BASE_URL }}
          CLANKER_VERIFY_TARGET: prod
        run: node scripts/clanker-verify.mjs --repo "${GITHUB_REPOSITORY}" --target "${CLANKER_VERIFY_TARGET}"
